      "settings": {
        "fallback": "mi-hero.jpg",
        "image_alt": "Mujer con una medalla grabada al cuello, a contraluz",
        "eager": true,
        "label": "Joyería personalizada",
        "heading": "Grabada para quien la lleva",
        "heading_tag": "h1",
        "button_label": "Personalizar la tuya",
        "button_link": "/products/medalla-firma",
        "height_desktop": 680,
        "height_mobile": 540,
        "padding_top_desktop": 0,
        "padding_top_mobile": 0
      }
    },
    "triptico": {
      "type": "mi-triptych",
      "blocks": {
        "boceto_medalla": {
          "type": "panel",
          "settings": {
            "fallback": "mi-boceto-medalla.svg",
            "alt": "Boceto 01 — Medalla, frente"
          }
        },
        "foto": {
          "type": "panel",
          "settings": {
            "fallback": "mi-triptico.jpg",
            "alt": "Medalla de plata grabada sobre piedra oscura"
          }
        },
        "boceto_sello": {
          "type": "panel",
          "settings": {
            "fallback": "mi-boceto-sello.svg",
            "alt": "Boceto 02 — Sello, frente y perfil"
          }
        }
      },
      "block_order": [
        "boceto_medalla",
        "foto",
        "boceto_sello"
      ]
    },
    "declaracion": {
      "type": "mi-statement",
      "settings": {
        "heading": "Una pieza escrita por ti",
        "text": "Tus iniciales, una fecha o un dibujo: tú decides qué se graba y en qué metal. Lo ves en 3D antes de pedirlo y nosotros lo convertimos en una pieza que no existe en ningún otro lugar."
      }
    },
