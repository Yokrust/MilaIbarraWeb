            "tag": "A la medida",
            "link": "/products/medalla-firma?material=oro"
          }
        },
        "plata": {
          "type": "card",
          "settings": {
            "fallback": "mi-prod-plata.jpg",
            "title": "Medalla Firma, plata, iniciales grabadas",
            "price": "$0,000 MXN",
            "tag": "A la medida",
            "link": "/products/medalla-firma?material=plata"
          }
        },
        "rosa": {
          "type": "card",
          "settings": {
            "fallback": "mi-prod-rosa.jpg",
            "title": "Medalla Firma, oro rosa, iniciales grabadas",
            "price": "$0,000 MXN",
            "tag": "A la medida",
            "link": "/products/medalla-firma?material=oro-rosa"
          }
        },
        "dibujo": {
          "type": "card",
          "settings": {
            "fallback": "mi-prod-dibujo.jpg",
            "title": "Medalla Firma, oro, con tu dibujo",
            "price": "$0,000 MXN",
            "tag": "A la medida",
            "link": "/products/medalla-firma?material=oro&imagen=1"
          }
        }
      },
      "block_order": [
        "oro",
        "plata",
        "rosa",
        "dibujo"
      ]
    },
    "editorial": {
      "type": "mi-editorial",
      "settings": {
        "quote": "“Una joya no se elige: se escribe.”",
        "image_alt": "Mujer tocando una medalla de oro grabada con sus iniciales",
        "button_label": "Personalizar la tuya",
        "button_link": "/products/medalla-firma",
        "quote_2": "Empieza con algo tuyo —unas iniciales, una fecha, un trazo— y termina en una pieza que no existe en ningún otro lugar.",
        "attribution": "— Mila Ibarra"
      }
    },
    "dos_formas": {
      "type": "mi-two-ways",
      "blocks": {
        "texto": {
          "type": "way",
          "settings": {
            "fallback": "mi-par-texto.jpg",
            "image_alt": "Medalla de oro con las iniciales M·I grabadas",
            "button_label": "Escribir el tuyo",
            "button_link": "/products/medalla-firma",
            "label": "A · Texto",
            "heading": "Tu texto, en nuestra letra",
            "text": "Iniciales, una fecha o un nombre corto, en romana o en cursiva."
          }
        },
        "imagen": {
          "type": "way",
          "settings": {
            "fallback": "mi-par-imagen.jpg",
            "image_alt": "Dibujo de una margarita junto a la medalla grabada con él",
            "button_label": "Subir una imagen",
            "button_link": "/products/medalla-firma?imagen=1",
            "label": "B · Imagen",
            "heading": "Tu dibujo, convertido en grabado",
            "text": "Sube una imagen: la pasamos a escala de grises y el taller la revisa contigo."
          }
        }
      },
      "block_order": [
        "texto",
        "imagen"
      ]
    },
    "banner": {
      "type": "mi-spin-banner",
      "settings": {
        "image_alt": "Medalla de oro con las iniciales M·I grabadas, girando sobre fondo negro",
        "label": "El configurador 3D",
        "heading": "Mírala girar antes de pedirla",
        "button_label": "Abrir el configurador",
        "button_link": "/products/medalla-firma",
        "scroll_desktop": 260,
        "scroll_mobile": 220,
        "padding_top_desktop": 96,
        "padding_top_mobile": 0
      }
    },
    "linea_de_tiempo": {
      "type": "mi-timeline",
      "blocks": {
        "tl0": {
          "type": "event",
          "settings": {
            "title": "Cómo nace tu pieza",
            "text": "Del texto que escribes a la pieza que llevas puesta. Nada se produce sin que lo hayas visto antes.",
            "fallback": "mi-tl-0.jpg"
          }
        },
        "tl1": {
          "type": "event",
          "settings": {
            "title": "Escríbela",
            "text": "Iniciales, una fecha, un nombre corto o una imagen tuya.",
            "fallback": "mi-tl-1.jpg"
          }
        },
        "tl2": {
          "type": "event",
          "settings": {
            "title": "Mírala en 3D",
            "text": "La vista previa gira con tus cambios: texto, tipografía y material.",
            "fallback": "mi-tl-2.jpg"
          }
        },
        "tl3": {
          "type": "event",
          "settings": {
            "title": "La revisamos contigo",
            "text": "El taller revisa tu texto o tu imagen antes de producir.",
            "fallback": "mi-tl-3.jpg"
          }
        },
        "tl4": {
          "type": "event",
          "settings": {
            "title": "Se fabrica",
            "text": "El taller la produce [a mano o con láser — por confirmar].",
            "fallback": "mi-tl-4.jpg"
          }
        },
        "tl5": {
          "type": "event",
          "settings": {
            "title": "Llega a ti",
            "text": "En [TIEMPO DE ENTREGA], lista para llevar puesta.",
            "fallback": "mi-tl-5.jpg"
          }
        }
      },
      "block_order": [
        "tl0",
        "tl1",
        "tl2",
        "tl3",
        "tl4",
        "tl5"
      ]
    },
    "contacto": {
      "type": "mi-cta-contact",
      "settings": {
        "label": "Contacto",
        "heading": "¿Tienes una idea? Hablemos.",
        "text": "Si lo que quieres grabar no cabe en el configurador, escríbenos y lo resolvemos contigo.",
        "whatsapp_label": "WhatsApp Business",
        "form_label": "Formulario de contacto"
      }
    }
