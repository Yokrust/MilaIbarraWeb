{% comment %}
  Collection (Figma: "Colección (Mujer) — Laptop 1440" 22:268 and
  "Colección (Mujer) — Móvil 390" 25:204). Built for launch but only linked
  when the theme setting "Mostrar tienda" is on; until then it still renders
  for preview and snippets/mi-head.liquid marks it noindex.

  Centered header, filter + sort bar (Shopify storefront filters, i.e. the
  Search & Discovery app), product grid of snippets/mi-product-card with
  editorial tiles (blocks) interleaved at a chosen position, and
  "Ver más piezas" (loads the next page in place; plain link without JS).
{% endcomment %}

{%- liquid
  assign per_page = section.settings.products_per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
-%}

{%- paginate collection.products by per_page -%}
  <section class="mi-collection" data-testid="mi-collection-{{ section.id }}">
    <header class="mi-collection__head">
      <p class="mi-label mi-ink-3">{{ section.settings.eyebrow }}</p>
      <h1 class="mi-h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="mi-body mi-ink-2 mi-collection__desc">{{ collection.description }}</div>
      {%- elsif section.settings.fallback_description != blank -%}
        <p class="mi-body mi-ink-2 mi-collection__desc">{{ section.settings.fallback_description }}</p>
      {%- endif -%}
    </header>

    <form class="mi-collection__bar" action="{{ collection.url }}" method="get" data-mi-filters>
      <details class="mi-collection__filter-toggle" data-mi-filter-toggle>
        <summary class="mi-label">
          Filtrar{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}
          {% render 'mi-icon', name: 'plus-sm' %}
        </summary>
      </details>

      <div class="mi-collection__filters">
        <span class="mi-label mi-ink-3 mi-collection__filters-label">Filtrar</span>
        {%- for filter in collection.filters -%}
          <details class="mi-collection__filter">
            <summary class="mi-label">
              {{ filter.label }}
              {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
              {% render 'mi-icon', name: 'plus-sm' %}
            </summary>
            <div class="mi-collection__filter-panel">
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="mi-collection__price">
                    <label class="mi-field">
                      <span class="mi-field__label mi-label">Desde</span>
                      <input
                        class="mi-field__input"
                        type="number"
                        inputmode="decimal"
                        name="{{ filter.min_value.param_name }}"
                        value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                        placeholder="0"
                        min="0"
                      >
                    </label>
                    <label class="mi-field">
                      <span class="mi-field__label mi-label">Hasta</span>
                      <input
                        class="mi-field__input"
                        type="number"
                        inputmode="decimal"
                        name="{{ filter.max_value.param_name }}"
                        value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                        placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                        min="0"
                      >
                    </label>
                  </div>
                {%- else -%}
                  <ul class="mi-collection__options" role="list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="mi-collection__option mi-body{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}
                              checked
                            {% endif %}
                            {% if value.count == 0 and value.active == false %}
                              disabled
                            {% endif %}
                          >
                          <span>{{ value.label }}</span>
                          <span class="mi-ink-3">({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
        {%- if active_filter_count > 0 -%}
          <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="mi-link mi-label mi-ink-3">Quitar filtros</a>
        {%- endif -%}
        <noscript><button type="submit" class="mi-btn mi-btn--secondary">Aplicar</button></noscript>
      </div>

      <div class="mi-collection__sort">
        <span class="mi-body mi-ink-3 mi-collection__count">
          {{ collection.products_count }}
          {% if collection.products_count == 1 %}pieza{% else %}piezas{% endif %}
        </span>
        <label class="mi-label mi-collection__sort-label">
          <span>Ordenar:</span>
          <select name="sort_by" class="mi-label" aria-label="Ordenar">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>
        </label>
      </div>
    </form>

    <div class="mi-collection__grid" data-mi-collection-grid>
      {%- assign offset = paginate.current_offset -%}
      {%- for product in collection.products -%}
        {%- assign position = offset | plus: forloop.index -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.position == position -%}
            {%- assign tile_link = block.settings.link | default: '#' -%}
            <div class="mi-collection__editorial" {{ block.shopify_attributes }}>
              {% render 'mi-image',
                image: block.settings.image,
                fallback: block.settings.fallback,
                alt: block.settings.heading,
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'mi-collection__editorial-img'
              %}
              <span class="mi-shade"></span>
              <div class="mi-collection__editorial-text">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="mi-label">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                <p class="mi-h3">{{ block.settings.heading }}</p>
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ tile_link }}" class="mi-btn mi-btn--on-image">{{ block.settings.button_label }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        <div class="mi-collection__item">
          {% render 'mi-product-card', product: product, sizes: '(min-width: 750px) 25vw, 50vw' %}
        </div>
      {%- else -%}
        <div class="mi-collection__empty">
          <p class="mi-body-lg">No hay piezas que coincidan.</p>
          {%- if active_filter_count > 0 -%}
            <a href="{{ collection.url }}" class="mi-btn mi-btn--secondary">Quitar filtros</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.next -%}
      <div class="mi-collection__more">
        <a href="{{ paginate.next.url }}" class="mi-btn mi-btn--secondary" data-mi-load-more>Ver más piezas</a>
      </div>
    {%- endif -%}
  </section>
{%- endpaginate -%}

<script src="{{ 'mi-collection.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  .mi-collection {
    max-width: var(--mi-max-width);
    margin-inline: auto;
    padding: 0 var(--mi-gutter) 56px;
  }

  .mi-collection__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 40px 0 24px;
    text-align: center;
  }

  .mi-collection__head p,
  .mi-collection__head h1 {
    margin: 0;
  }

  .mi-collection__head .mi-h1 {
    font-size: 28px;
    line-height: 38px;
  }

  .mi-collection__desc {
    max-width: 460px;
  }

  .mi-collection__desc p {
    margin: 0;
  }

  /* Filter bar */
  .mi-collection__bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    border-top: 1px solid var(--mi-line);
    border-bottom: 1px solid var(--mi-line);
  }

  .mi-collection__bar summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    cursor: pointer;
  }

  .mi-collection__bar summary::-webkit-details-marker {
    display: none;
  }

  .mi-collection__bar details[open] > summary .mi-icon {
    transform: rotate(45deg);
  }

  .mi-collection__filters {
    display: none;
    order: 3;
    flex-basis: 100%;
    flex-direction: column;
    gap: 0;
    padding-bottom: 16px;
  }

  .mi-collection__bar.is-filters-open .mi-collection__filters {
    display: flex;
  }

  .mi-collection__filters-label {
    display: none;
  }

  .mi-collection__filter {
    border-top: 1px solid var(--mi-line);
  }

  .mi-collection__filter > summary {
    display: flex;
    justify-content: space-between;
    height: 48px;
  }

  .mi-collection__filter-panel {
    padding: 4px 0 16px;
  }

  .mi-collection__options {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mi-collection__option {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .mi-collection__option input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--mi-ink);
  }

  .mi-collection__option.is-disabled {
    opacity: 0.4;
    cursor: default;
  }

  .mi-collection__price {
    display: flex;
    gap: 12px;
  }

  .mi-collection__sort {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .mi-collection__count {
    display: none;
  }

  .mi-collection__sort-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .mi-collection__sort select {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--mi-ink);
    cursor: pointer;
  }

  /* Grid */
  .mi-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding-top: 16px;
  }

  .mi-collection__editorial {
    position: relative;
    grid-column: 1 / -1;
    min-height: 320px;
    overflow: hidden;
    background: var(--mi-tile);
    color: var(--mi-white);
  }

  .mi-collection__editorial-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mi-collection__editorial .mi-shade {
    height: 62%;
  }

  .mi-collection__editorial-text {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .mi-collection__editorial-text p {
    margin: 0;
  }

  .mi-collection__editorial-text .mi-btn {
    margin-top: 4px;
  }

  .mi-collection__empty {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 64px 0;
  }

  .mi-collection__more {
    display: flex;
    justify-content: center;
    padding-top: 48px;
  }

  @media screen and (min-width: 750px) {
    .mi-collection {
      padding-bottom: 96px;
    }

    .mi-collection__head {
      padding: 56px 0 40px;
    }

    .mi-collection__head .mi-h1 {
      font-size: 32px;
      line-height: 42px;
    }

    .mi-collection__bar {
      flex-wrap: nowrap;
      min-height: 56px;
    }

    .mi-collection__filter-toggle {
      display: none;
    }

    .mi-collection__filters,
    .mi-collection__bar.is-filters-open .mi-collection__filters {
      display: flex;
      order: 0;
      flex-basis: auto;
      flex-direction: row;
      align-items: center;
      gap: 28px;
      padding: 0;
    }

    .mi-collection__filters-label {
      display: inline;
    }

    .mi-collection__filter {
      position: relative;
      border-top: 0;
    }

    .mi-collection__filter > summary {
      height: auto;
    }

    .mi-collection__filter-panel {
      position: absolute;
      top: calc(100% + 19px);
      left: -16px;
      z-index: 5;
      min-width: 240px;
      padding: 16px;
      background: var(--mi-white);
      border: 1px solid var(--mi-line);
    }

    .mi-collection__count {
      display: inline;
    }

    .mi-collection__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 48px;
      padding-top: 48px;
    }

    .mi-collection__editorial {
      grid-column: span 2;
      min-height: 360px;
    }

    .mi-collection__editorial .mi-shade {
      height: 61%;
    }

    .mi-collection__editorial-text {
      left: 24px;
      bottom: 24px;
      gap: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mila Ibarra · Colección",
  "tag": "div",
  "class": "mi-collection-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Solo se enlaza en la navegación cuando \"Mostrar tienda\" está activo en Ajustes del tema."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Colección"
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Descripción (si la colección no tiene una)",
      "default": "Piezas para llevar todos los días. Las que llevan el sello “A la medida” pueden grabarse."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Piezas por página",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "editorial",
      "name": "Mosaico editorial",
      "settings": [
        {
          "type": "range",
          "id": "position",
          "label": "Aparece antes de la pieza número",
          "min": 1,
          "max": 48,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Foto de muestra (si no eliges una)",
          "options": [
            { "value": "mi-editorial.jpg", "label": "Retrato con la medalla" },
            { "value": "mi-par-imagen.jpg", "label": "Dibujo y medalla" },
            { "value": "mi-par-texto.jpg", "label": "Medalla con iniciales" },
            { "value": "mi-hero.jpg", "label": "Retrato de campaña" }
          ],
          "default": "mi-editorial.jpg"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Antetítulo",
          "default": "Joyería personalizada"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Grabada para quien la lleva"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Personalizar la tuya"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace del botón"
        }
      ]
    }
  ]
}
{% endschema %}
