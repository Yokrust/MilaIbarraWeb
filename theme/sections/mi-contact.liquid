{% comment %}
  Contacto (Figma: "Contacto — Laptop 1440" 21:198 and "Contacto — Móvil 390"
  24:269). Workshop photo on the left, native Shopify contact form on the
  right, then a direct line (WhatsApp Business + e-mail). No app needed.

  WhatsApp number, e-mail and response time come from the global theme
  settings "Mila Ibarra — Contacto" (pending from the client).
{% endcomment %}

{%- liquid
  assign whatsapp_number = settings.mi_whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_number
  if section.settings.whatsapp_message != blank
    assign whatsapp_text = section.settings.whatsapp_message | url_encode
    assign whatsapp_url = whatsapp_url | append: '?text=' | append: whatsapp_text
  endif
-%}

<section class="mi-contact" data-testid="mi-contact-{{ section.id }}">
  <div class="mi-contact__media">
    {% render 'mi-image',
      image: section.settings.image,
      fallback: 'mi-contacto.jpg',
      alt: section.settings.image_alt,
      sizes: '(min-width: 750px) 45vw, 100vw',
      class: 'mi-contact__img',
      eager: true
    %}
  </div>

  <div class="mi-contact__content">
    <div class="mi-contact__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mi-label mi-ink-3">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="mi-h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="mi-body-lg mi-ink-2 mi-contact__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    {%- form 'contact', id: 'MiContactForm', class: 'mi-contact__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="mi-contact__notice mi-contact__notice--success" role="status" tabindex="-1" autofocus>
          <p class="mi-label">Mensaje enviado</p>
          <p class="mi-body mi-ink-2">{{ section.settings.success_text }}</p>
        </div>
      {%- elsif form.errors -%}
        <div class="mi-contact__notice mi-contact__notice--error" role="alert" tabindex="-1" autofocus>
          <p class="mi-label">Revisa estos campos</p>
          <ul class="mi-body mi-ink-2">
            {%- for field in form.errors -%}
              <li>
                {%- case field -%}
                  {%- when 'email' -%}
                    Correo electrónico: {{ form.errors.messages[field] }}
                  {%- when 'body' -%}
                    Mensaje: {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="mi-field">
        <label class="mi-field__label mi-label" for="MiContact-name">Nombre</label>
        <input
          class="mi-field__input"
          type="text"
          id="MiContact-name"
          name="contact[name]"
          autocomplete="name"
          placeholder="Tu nombre"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >
      </div>

      <div class="mi-field">
        <label class="mi-field__label mi-label" for="MiContact-email">
          Correo electrónico <span aria-hidden="true">*</span>
        </label>
        <input
          class="mi-field__input"
          type="email"
          id="MiContact-email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          aria-required="true"
          placeholder="nombre@correo.com"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
          {% endif %}
        >
      </div>

      <div class="mi-field">
        <label class="mi-field__label mi-label" for="MiContact-phone">Teléfono (opcional)</label>
        <input
          class="mi-field__input"
          type="tel"
          id="MiContact-phone"
          name="contact[phone]"
          autocomplete="tel"
          pattern="[0-9\-\s\+\(\)]*"
          placeholder="Para responderte por WhatsApp"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        >
      </div>

      <div class="mi-field">
        <label class="mi-field__label mi-label" for="MiContact-body">
          Mensaje <span aria-hidden="true">*</span>
        </label>
        <textarea
          class="mi-field__input"
          id="MiContact-body"
          name="contact[body]"
          rows="5"
          required
          aria-required="true"
          placeholder="Cuéntanos qué quieres grabar y en qué pieza."
          {% if form.errors contains 'body' %}
            aria-invalid="true"
          {% endif %}
        >
          {{- form.body -}}
        </textarea>
      </div>

      <div class="mi-contact__submit">
        <button type="submit" class="mi-btn mi-btn--primary">Enviar mensaje</button>
      </div>
    {%- endform -%}

    <div class="mi-contact__direct">
      <p class="mi-label">O escríbenos directo</p>
      <div class="mi-contact__direct-row">
        <a
          href="{{ whatsapp_url }}"
          class="mi-btn mi-btn--secondary"
          target="_blank"
          rel="noopener"
          {% if whatsapp_number == blank %}
            aria-disabled="true"
          {% endif %}
        >
          WhatsApp Business
        </a>
        {%- if settings.mi_email != blank -%}
          {%- if settings.mi_email contains '@' -%}
            <a href="mailto:{{ settings.mi_email }}" class="mi-body-lg mi-contact__email">{{ settings.mi_email }}</a>
          {%- else -%}
            <span class="mi-body-lg mi-contact__email">{{ settings.mi_email }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if settings.mi_response_time != blank -%}
        <p class="mi-body mi-ink-3">Respondemos en {{ settings.mi_response_time }}.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .mi-contact {
    display: flex;
    flex-direction: column;
    max-width: var(--mi-max-width);
    margin-inline: auto;
    padding-bottom: 64px;
  }

  .mi-contact__media {
    aspect-ratio: 390 / 300;
    overflow: hidden;
    background: var(--mi-tile);
  }

  .mi-contact__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mi-contact__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px var(--mi-gutter) 0;
  }

  .mi-contact__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mi-contact__head p,
  .mi-contact__head h1 {
    margin: 0;
  }

  .mi-contact__head .mi-h1 {
    font-size: 28px;
    line-height: 38px;
  }

  .mi-contact__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .mi-contact__submit {
    padding-top: 6px;
  }

  .mi-contact__submit .mi-btn {
    width: 100%;
  }

  .mi-contact__notice {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    background: var(--mi-tile);
    border-left: 2px solid var(--mi-ink);
  }

  .mi-contact__notice p,
  .mi-contact__notice ul {
    margin: 0;
  }

  .mi-contact__notice ul {
    padding-left: 18px;
  }

  .mi-contact__notice--error {
    border-left-color: #b3261e;
  }

  .mi-field__input[aria-invalid='true'] {
    border-color: #b3261e;
  }

  .mi-contact__direct {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
    border-top: 1px solid var(--mi-line);
  }

  .mi-contact__direct p {
    margin: 0;
  }

  .mi-contact__direct-row {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mi-contact__direct-row .mi-btn {
    width: 100%;
  }

  .mi-contact__email {
    color: var(--mi-ink);
    text-decoration: none;
  }

  a.mi-contact__email:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .mi-contact {
      flex-direction: row;
      align-items: flex-start;
      gap: clamp(48px, 6.67vw, 96px);
      padding: 48px var(--mi-gutter) 96px;
    }

    .mi-contact__media {
      flex: 0 1 648px;
      aspect-ratio: 648 / 800;
    }

    .mi-contact__content {
      flex: 0 1 552px;
      gap: 28px;
      padding: 24px 0 0;
    }

    .mi-contact__head {
      gap: 12px;
    }

    .mi-contact__head .mi-h1 {
      font-size: 32px;
      line-height: 42px;
    }

    .mi-contact__intro {
      max-width: 500px;
    }

    .mi-contact__form {
      gap: 20px;
    }

    .mi-contact__submit .mi-btn,
    .mi-contact__direct-row .mi-btn {
      width: auto;
    }

    .mi-contact__direct-row {
      flex-direction: row;
      align-items: center;
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mila Ibarra · Contacto",
  "tag": "div",
  "class": "mi-contact-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto",
      "info": "Mientras no elijas una, se usa la foto del taller incluida en el tema."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la foto",
      "default": "Mesa de trabajo del taller con herramientas de joyería"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Contacto"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Hablemos de tu pieza"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introducción",
      "default": "Cuéntanos qué tienes en mente —una idea, una fecha, una duda sobre materiales— y te respondemos por correo o por WhatsApp."
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Mensaje al enviar",
      "default": "Gracias. Te respondemos pronto por correo o por WhatsApp."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje inicial de WhatsApp",
      "default": "Hola, quiero hablar de una pieza personalizada."
    },
    {
      "type": "paragraph",
      "content": "El número de WhatsApp, el correo y el tiempo de respuesta se editan en Ajustes del tema → Mila Ibarra — Tienda."
    }
  ]
}
{% endschema %}
