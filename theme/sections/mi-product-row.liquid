{% comment %}
  Fila de producto (Figma 18:68 on Home, 20:250 "Otros metales" on the
  configurator page; mobile 23:59 / 24:214). Four product cards; optional
  heading row with a right-aligned count label.

  Each card is a block: pick a real product, or fill the static fields (the
  four Medalla Firma versions are presets of one configurable product, so
  their links carry ?material=… for the configurator to read).
{% endcomment %}

{%- liquid
  assign has_head = false
  if section.settings.heading != blank or section.settings.count_label != blank
    assign has_head = true
  endif
-%}

<div
  class="mi-product-row{% if has_head %} mi-product-row--with-head{% endif %}"
  style="--mi-row-pt: {{ section.settings.padding_top }}px; --mi-row-pb: {{ section.settings.padding_bottom }}px;"
  data-testid="mi-product-row-{{ section.id }}"
>
  {%- if has_head -%}
    <div class="mi-product-row__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="mi-h2 mi-product-row__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.count_label != blank -%}
        <p class="mi-label mi-ink-3 mi-product-row__count">{{ section.settings.count_label }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="mi-product-row__grid" role="list">
    {%- for block in section.blocks -%}
      <li class="mi-product-row__item" {{ block.shopify_attributes }} data-mi-reveal style="--mi-reveal-delay: {{ forloop.index0 | times: 80 }}ms;">
        {% render 'mi-product-card',
          product: block.settings.product,
          image: block.settings.image,
          fallback: block.settings.fallback,
          title: block.settings.title,
          price: block.settings.price,
          url: block.settings.link,
          tag: block.settings.tag
        %}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .mi-product-row {
    padding: 0 var(--mi-gutter) var(--mi-row-pb, 0px);
  }

  .mi-product-row--with-head {
    padding-top: 56px;
  }

  .mi-product-row__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .mi-product-row__count {
    display: none;
  }

  .mi-product-row__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mi-product-row__item {
    transition-delay: var(--mi-reveal-delay, 0ms);
  }

  @media screen and (min-width: 750px) {
    .mi-product-row {
      padding-top: var(--mi-row-pt, 0px);
    }

    .mi-product-row--with-head {
      padding-top: max(var(--mi-row-pt, 0px), 96px);
    }

    .mi-product-row__head {
      margin-bottom: 40px;
    }

    .mi-product-row__count {
      display: block;
      padding-bottom: 4px;
    }

    .mi-product-row__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MI · Fila de producto",
  "tag": "section",
  "class": "mi-product-row-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título (opcional)"
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Etiqueta a la derecha (opcional)",
      "info": "Por ejemplo \"4 versiones\". Solo se ve en escritorio."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto",
          "info": "Si eliges uno, su foto, nombre, precio y enlace reemplazan los campos de abajo."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Imagen de muestra",
          "options": [
            { "value": "mi-prod-oro.jpg", "label": "Medalla, oro" },
            { "value": "mi-prod-plata.jpg", "label": "Medalla, plata" },
            { "value": "mi-prod-rosa.jpg", "label": "Medalla, oro rosa" },
            { "value": "mi-prod-dibujo.jpg", "label": "Medalla con dibujo" },
            { "value": "mi-col-anillo.jpg", "label": "Anillo sello" },
            { "value": "mi-col-esclava.jpg", "label": "Esclava" },
            { "value": "mi-col-pulsera.jpg", "label": "Pulsera placa" },
            { "value": "mi-col-aretes.jpg", "label": "Arracadas" }
          ],
          "default": "mi-prod-oro.jpg"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre",
          "default": "Medalla Firma, oro, iniciales grabadas"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio",
          "default": "$0,000 MXN"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Etiqueta",
          "default": "A la medida"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MI · Fila de producto",
      "blocks": [
        { "type": "card", "settings": { "fallback": "mi-prod-oro.jpg", "title": "Medalla Firma, oro, iniciales grabadas" } },
        { "type": "card", "settings": { "fallback": "mi-prod-plata.jpg", "title": "Medalla Firma, plata, iniciales grabadas" } },
        { "type": "card", "settings": { "fallback": "mi-prod-rosa.jpg", "title": "Medalla Firma, oro rosa, iniciales grabadas" } },
        { "type": "card", "settings": { "fallback": "mi-prod-dibujo.jpg", "title": "Medalla Firma, oro, con tu dibujo" } }
      ]
    }
  ]
}
{% endschema %}
