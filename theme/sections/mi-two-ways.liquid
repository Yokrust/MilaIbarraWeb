{% comment %}
  Dos formas de grabar (Figma 18:111 / mobile 23:104–23:116): two tall photos
  side by side, each with an on-image button and a caption (label, H3, body).
  Mobile: stacked, full-bleed photos. Each column is a block.
{% endcomment %}

<div class="mi-two-ways" data-testid="mi-two-ways-{{ section.id }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign button_url = block.settings.button_link
      if button_url == blank
        assign button_url = '/products/medalla-firma'
      endif
    -%}
    <article class="mi-two-ways__item" {{ block.shopify_attributes }} data-mi-reveal>
      <div class="mi-two-ways__photo mi-media">
        {% render 'mi-image',
          image: block.settings.image,
          fallback: block.settings.fallback,
          alt: block.settings.image_alt,
          sizes: '(min-width: 750px) 50vw, 100vw',
          class: 'mi-two-ways__img'
        %}
        {%- if block.settings.button_label != blank -%}
          <a href="{{ button_url }}" class="mi-btn mi-btn--on-image mi-two-ways__button">{{ block.settings.button_label }}</a>
        {%- endif -%}
      </div>
      <div class="mi-two-ways__caption">
        {%- if block.settings.label != blank -%}
          <p class="mi-label mi-ink-3">{{ block.settings.label }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h3 class="mi-h3">{{ block.settings.heading }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="mi-body mi-ink-2 mi-two-ways__text">{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</div>

{% stylesheet %}
  .mi-two-ways {
    display: flex;
    flex-direction: column;
    color: var(--mi-ink);
  }

  .mi-two-ways__photo {
    position: relative;
    aspect-ratio: 390 / 452;
  }

  .mi-two-ways__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mi-two-ways__button {
    position: absolute;
    left: 16px;
    bottom: 16px;
  }

  .mi-two-ways__caption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 40px;
  }

  .mi-two-ways__text {
    max-width: 420px;
  }

  @media screen and (min-width: 750px) {
    .mi-two-ways {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
      padding-inline: 32px;
    }

    .mi-two-ways__item {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .mi-two-ways__photo {
      aspect-ratio: 680 / 788;
    }

    .mi-two-ways__button {
      left: 24px;
      bottom: 24px;
    }

    .mi-two-ways__caption {
      padding: 0 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MI · Dos formas",
  "tag": "section",
  "class": "mi-two-ways-section",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "way",
      "name": "Columna",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Foto de muestra",
          "options": [
            { "value": "mi-par-texto.jpg", "label": "Medalla con iniciales" },
            { "value": "mi-par-imagen.jpg", "label": "Dibujo y medalla" }
          ],
          "default": "mi-par-texto.jpg"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texto alternativo"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Escribir el tuyo"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "A · Texto"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Tu texto, en nuestra letra"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Iniciales, una fecha o un nombre corto, en romana o en cursiva."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MI · Dos formas",
      "blocks": [
        { "type": "way" },
        {
          "type": "way",
          "settings": {
            "fallback": "mi-par-imagen.jpg",
            "button_label": "Subir una imagen",
            "label": "B · Imagen",
            "heading": "Tu dibujo, convertido en grabado",
            "text": "Sube una imagen: la pasamos a escala de grises y el taller la revisa contigo."
          }
        }
      ]
    }
  ]
}
{% endschema %}
