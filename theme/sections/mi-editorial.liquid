{% comment %}
  Editorial (Figma 18:102 / mobile 23:95, 23:97, 23:101): italic serif quote,
  tall portrait with an on-image button, second quote with attribution.
  Mobile: the portrait goes full-bleed.
{% endcomment %}

{%- liquid
  assign button_url = section.settings.button_link
  if button_url == blank
    if section.settings.product != blank
      assign button_url = section.settings.product.url
    else
      assign button_url = '/products/medalla-firma'
    endif
  endif
-%}

<div class="mi-editorial" data-testid="mi-editorial-{{ section.id }}">
  {%- if section.settings.quote != blank -%}
    <blockquote class="mi-quote mi-editorial__quote mi-editorial__quote--first" data-mi-reveal>
      {{- section.settings.quote -}}
    </blockquote>
  {%- endif -%}

  <div class="mi-editorial__portrait mi-media" data-mi-reveal>
    {% render 'mi-image',
      image: section.settings.image,
      fallback: 'mi-editorial.jpg',
      alt: section.settings.image_alt,
      sizes: '(min-width: 750px) 680px, 100vw',
      class: 'mi-editorial__img'
    %}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ button_url }}" class="mi-btn mi-btn--on-image mi-editorial__button">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>

  {%- if section.settings.quote_2 != blank -%}
    <figure class="mi-editorial__second" data-mi-reveal>
      <blockquote class="mi-quote mi-editorial__quote">{{ section.settings.quote_2 }}</blockquote>
      {%- if section.settings.attribution != blank -%}
        <figcaption class="mi-label">{{ section.settings.attribution }}</figcaption>
      {%- endif -%}
    </figure>
  {%- endif -%}
</div>

{% stylesheet %}
  .mi-editorial {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 64px;
    color: var(--mi-ink);
    text-align: center;
  }

  .mi-editorial__quote {
    max-width: 900px;
    margin: 0;
    padding-inline: 30px;
  }

  .mi-editorial__quote--first {
    margin-bottom: 32px;
  }

  .mi-editorial__portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 390 / 488;
  }

  .mi-editorial__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mi-editorial__button {
    position: absolute;
    left: 16px;
    bottom: 16px;
  }

  .mi-editorial__second {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin: 32px 0 0;
  }

  @media screen and (min-width: 750px) {
    .mi-editorial {
      gap: 56px;
      padding-block: 96px;
    }

    .mi-editorial__quote {
      padding-inline: var(--mi-gutter);
      box-sizing: content-box;
    }

    .mi-editorial__quote--first {
      margin-bottom: 0;
    }

    .mi-editorial__portrait {
      width: min(680px, calc(100% - 2 * var(--mi-gutter)));
      aspect-ratio: 680 / 853;
    }

    .mi-editorial__button {
      left: 24px;
      bottom: 24px;
    }

    .mi-editorial__second {
      gap: 20px;
      margin-top: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MI · Editorial",
  "tag": "section",
  "class": "mi-editorial-section",
  "settings": [
    {
      "type": "text",
      "id": "quote",
      "label": "Cita principal",
      "default": "“Una joya no se elige: se escribe.”"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Retrato"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "default": "Mujer tocando una medalla de oro grabada con sus iniciales"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Personalizar la tuya"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto de joyería personalizada"
    },
    {
      "type": "textarea",
      "id": "quote_2",
      "label": "Segunda cita",
      "default": "Empieza con algo tuyo —unas iniciales, una fecha, un trazo— y termina en una pieza que no existe en ningún otro lugar."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Firma",
      "default": "— Mila Ibarra"
    }
  ],
  "presets": [
    {
      "name": "MI · Editorial"
    }
  ]
}
{% endschema %}
