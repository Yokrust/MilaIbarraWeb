{% comment %}
  Full-bleed photo with a bottom shadow and centered label + heading + button.
  Used twice on Home (Figma 18:22 "Hero" and 18:131 "Banner configurador"):
  same layout, different height, top spacing and heading level.
{% endcomment %}

{%- liquid
  assign button_url = section.settings.button_link
  if button_url == blank
    if section.settings.product != blank
      assign button_url = section.settings.product.url
    else
      assign button_url = '/products/medalla-firma'
    endif
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

<div
  class="mi-hero"
  style="--mi-hero-h: {{ section.settings.height_desktop }}px; --mi-hero-h-mobile: {{ section.settings.height_mobile }}px; --mi-hero-pt: {{ section.settings.padding_top_desktop }}px; --mi-hero-pt-mobile: {{ section.settings.padding_top_mobile }}px;"
  data-testid="mi-hero-{{ section.id }}"
>
  <div class="mi-hero__frame">
    <div class="mi-hero__media">
      {% render 'mi-image',
        image: section.settings.image,
        fallback: section.settings.fallback,
        alt: section.settings.image_alt,
        eager: section.settings.eager,
        class: 'mi-hero__img'
      %}
    </div>
    <div class="mi-shade mi-hero__shade" aria-hidden="true"></div>

    <div class="mi-hero__content" data-mi-reveal>
      {%- if section.settings.label != blank -%}
        <p class="mi-label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="mi-h1 mi-hero__heading">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="mi-hero__cta">
          <a href="{{ button_url }}" class="mi-btn mi-btn--on-image">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .mi-hero {
    padding-top: var(--mi-hero-pt-mobile, 0px);
  }

  .mi-hero__frame {
    position: relative;
    height: var(--mi-hero-h-mobile, 540px);
    overflow: hidden;
    background: var(--mi-ink);
  }

  .mi-hero__media,
  .mi-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mi-hero__img {
    object-fit: cover;
  }

  .mi-hero__shade {
    height: 60%;
  }

  .mi-hero__content {
    position: absolute;
    inset: auto var(--mi-gutter) 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--mi-white);
    text-align: center;
  }

  .mi-hero__heading {
    max-width: 320px;
    font-size: 28px;
    line-height: 38px;
    color: inherit;
  }

  .mi-hero__cta {
    padding-top: 10px;
  }

  @media screen and (min-width: 750px) {
    .mi-hero {
      padding-top: var(--mi-hero-pt, 0px);
    }

    .mi-hero__frame {
      height: var(--mi-hero-h, 680px);
    }

    .mi-hero__shade {
      height: 53%;
    }

    .mi-hero__content {
      bottom: 48px;
      gap: 12px;
    }

    .mi-hero__heading {
      max-width: none;
      font-size: 32px;
      line-height: 42px;
    }

    .mi-hero__cta {
      padding-top: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MI · Foto a sangre",
  "tag": "section",
  "class": "mi-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "select",
      "id": "fallback",
      "label": "Foto de muestra (si no eliges una)",
      "options": [
        { "value": "mi-hero.jpg", "label": "Retrato (hero)" },
        { "value": "mi-banner.jpg", "label": "Medalla sobre negro (banner)" },
        { "value": "mi-editorial.jpg", "label": "Retrato editorial" }
      ],
      "default": "mi-hero.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "default": "Mujer con una medalla grabada al cuello"
    },
    {
      "type": "checkbox",
      "id": "eager",
      "label": "Cargar de inmediato (solo si es lo primero de la página)",
      "default": true
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta",
      "default": "Joyería personalizada"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Grabada para quien la lleva"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Nivel del título",
      "options": [
        { "value": "h1", "label": "H1 (título principal de la página)" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Personalizar la tuya"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón",
      "info": "Si lo dejas vacío, lleva al producto de abajo (o a /products/medalla-firma)."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto de joyería personalizada"
    },
    {
      "type": "header",
      "content": "Tamaño"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Alto en escritorio",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Alto en celular",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 540
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Espacio arriba en escritorio",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espacio arriba en celular",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "MI · Foto a sangre"
    }
  ]
}
{% endschema %}
